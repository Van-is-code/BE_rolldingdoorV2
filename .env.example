# File MAU. Copy thanh .env roi dien gia tri that.
# .env da nam trong .gitignore — TUYET DOI khong commit gia tri that vao file nay.

# Server Port
PORT=4000

# PostgreSQL Database Connection URL
# Dinh dang: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>
USE_SSL=false

# JWT Secret — sinh chuoi ngau nhien moi cho moi moi truong:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<chuoi-ngau-nhien-cua-ban>

# HiveMQ Cloud MQTT Config
HIVEMQ_CLUSTER_URL=<cluster-id>.s1.eu.hivemq.cloud
HIVEMQ_PORT=8883
HIVEMQ_USERNAME=<hivemq-username>
HIVEMQ_PASSWORD=<hivemq-password>

# Tai khoan Admin mac dinh — chi duoc tao o lan khoi dong dau tien.
# Dat mat khau manh, va doi ngay sau khi dang nhap lan dau.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<mat-khau-manh-cua-ban>
